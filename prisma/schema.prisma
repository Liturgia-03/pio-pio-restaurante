datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // "ADMIN" | "STAFF"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   // Ej: "Pollos Asados y Broaster", "Cortes a la Parrilla", "Acompañamientos", "Bebidas"
  slug        String   @unique
  description String?
  iconName    String?  // Nombre de icono Lucide (ej: "Flame", "UtensilsCrossed", "Beer", "Salad")
  imageUrl    String?  // Imagen de la categoría para la tarjeta del menú
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  dishes      Dish[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
  @@map("categories")
}

model Dish {
  id              String        @id @default(uuid())
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String        // Ej: "Medio Pollo Asado con Arepa y Papa", "Punta de Anca 350g"
  slug            String        @unique
  description     String        // Ingredientes, técnica de cocción a la leña, términos
  basePrice       Float
  discountPrice   Float?
  imageUrl        String
  imagePublicId   String?       // Para borrado o reemplazo en Cloudinary
  isAvailable     Boolean       @default(true) // Switch para marcar agotado en tiempo real
  isFeatured      Boolean       @default(false)
  badge           String        @default("NONE") // "NONE" | "POPULAR" | "CHEFS_SPECIAL" | "NEW" | "PROMO"
  preparationTime Int?          // Estimado en minutos (ej: 25)
  servings        String?       // Ej: "Para 1 persona", "Para 2 a 3 personas"
  sortOrder       Int           @default(0)
  portions        DishPortion[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
  @@index([sortOrder])
  @@map("dishes")
}

model DishPortion {
  id        String  @id @default(uuid())
  dishId    String
  dish      Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  label     String  // Ej: "1/4 de Pollo", "1/2 Pollo", "Pollo Entero" ó "300g", "500g"
  price     Float
  isDefault Boolean @default(false)

  @@map("dish_portions")
}

model PromotionalModal {
  id                 String   @id @default(uuid())
  // Campos de la Tarjeta de Bienvenida / Presentación (Paso 1)
  welcomeBadge       String?  @default("El Sabor Que Nos Une")
  welcomeTitle       String?  @default("¡Bienvenidos a Pío Pío!")
  welcomeSubtitle    String?  @default("Asadero & Restaurante Tradicional")
  welcomeDescription String?  @default("Disfruta de nuestros auténticos pollos asados al carbón y apanados crocantes, jugosos cortes a la brasa y las recetas típicas más queridas de nuestra tierra.")
  welcomeButtonText  String?  @default("Ver Oferta Especial de Hoy")
  welcomeTag1        String?  @default("Pollos")
  welcomeTag1Sub     String?  @default("Asado & Broaster")
  welcomeTag2        String?  @default("Parrilla")
  welcomeTag2Sub     String?  @default("A la Brasa")
  welcomeTag3        String?  @default("Típicos")
  welcomeTag3Sub     String?  @default("Bandejas & Sopas")

  // Campos del Plato Promocional (Paso 2)
  title              String   // Ej: "¡Especial del Día en Brasa y Carbón!"
  subtitle           String?  // Ej: "Costillas BBQ Campesinas + Cerveza Artesanal"
  description        String   // Descripción seductora para incentivar el consumo
  imageUrl           String
  imagePublicId      String?
  badgeText          String?  // Ej: "20% OFF HOY"
  regularPrice       Float?
  promoPrice         Float?
  ctaText            String   @default("Ver en el Menú")
  targetDishId       String?  // ID del plato para navegar al hacer clic
  isActive           Boolean  @default(true) // Control global para mostrar/ocultar el modal
  autoShowDelayMs    Int      @default(0)  // Milisegundos de espera antes de desplegar
  showOncePerSession Boolean  @default(true) // Evita molestar si el cliente navega internamente
  updatedAt          DateTime @updatedAt

  @@map("promotional_modals")
}

model RestaurantSettings {
  id                String   @id @default("default")
  name              String   @default("Pío Pío - Asadero y Restaurante")
  whatsapp          String   @default("573001234567")
  phone             String?  @default("573001234567")
  address           String   @default("Carrera Principal con Calle 10, Centro")
  schedule          String   @default("Lunes a Domingo: 10:00 AM a 9:00 PM")
  wifiSsid          String?  @default("PioPio-Clientes")
  wifiPassword      String?  @default("Parrilla2026*")
  logoUrl           String?  @default("/logo-pio-pio.png")
  headerImages      String?  @default("[]")
  headerTagline     String?  @default("Asadero & Restaurante Tradicional")
  headerDescription String?  @default("El auténtico sabor a la brasa, broaster y platos típicos")
  facebookUrl       String?  @default("")
  instagramUrl      String?  @default("")
  websiteUrl        String?  @default("")
  totalTables       Int      @default(15)
  updatedAt         DateTime @updatedAt

  @@map("restaurant_settings")
}

model RestaurantTable {
  id        String   @id @default(cuid())
  number    String   @unique // Ej: "1", "2", "3", "16"
  label     String?  // Ej: "Salón Principal", "Terraza", "VIP"
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_tables")
}

model Waiter {
  id        String         @id @default(cuid())
  name      String         // Ej: "Carlos", "Sandra"
  pin       String         // PIN de 4 dígitos para acceso rápido
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  sessions  TableSession[]

  @@map("waiters")
}

model TableSession {
  id          String      @id @default(cuid())
  tableNumber String      // Normalizado sin ceros a la izquierda: "1", "2", "5"
  status      TableStatus @default(OPEN)

  waiterId    String?
  waiter      Waiter?     @relation(fields: [waiterId], references: [id])

  total       Float       @default(0)

  deliveredAt DateTime?   // Última fecha/hora en que se entregó el pedido o adición en mesa
  closedAt    DateTime?
  closedBy    String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]

  @@index([status])
  @@index([tableNumber, status])
  @@index([closedAt])
  @@map("table_sessions")
}

model OrderItem {
  id              String       @id @default(cuid())
  tableSessionId  String
  tableSession    TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  dishId          String?
  dishName        String       // Nombre congelado al momento de pedir
  portionLabel    String?      // Ej: "1/2 Pollo", "Completo"
  unitPrice       Float
  quantity        Int          @default(1)
  subtotal        Float
  notes           String?      // Ej: "Sin ensalada", "Para llevar"

  addedBy         ItemSource   // CUSTOMER_QR, WAITER, ADMIN_CASHIER
  addedByName     String?      // Ej: "Cliente QR", "Carlos", "Caja"
  round           Int          @default(1) // Ronda 1 (inicio), Ronda 2 (adición)...

  status          ItemStatus   @default(CONFIRMED) // PENDING_CONFIRMATION, CONFIRMED, CANCELLED
  cancelledReason String?      // Motivo si el Admin elimina/anula el ítem
  deliveredAt     DateTime?    // Fecha/hora en que este ítem fue entregado en mesa


  createdAt       DateTime     @default(now())

  @@index([tableSessionId])
  @@map("order_items")
}

enum TableStatus {
  OPEN
  PENDING_CONFIRMATION
  BILL_REQUESTED
  CLOSED
}

enum ItemSource {
  CUSTOMER_QR
  WAITER
  ADMIN_CASHIER
}

enum ItemStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}



